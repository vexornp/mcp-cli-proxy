class McpCliProxy < Formula
  desc "Generic-executor MCP server: runs shell commands on the host PC, outside the agent sandbox"
  homepage "https://github.com/vexornp/mcp-cli-proxy"
  version "0.1.0"
  license "MIT"

  on_arm do
    url "https://github.com/vexornp/mcp-cli-proxy/releases/download/v0.1.0/mcp-cli-proxy-aarch64-apple-darwin.tar.gz"
    sha256 "REPLACE_WITH_ARM_SHA256"
  end

  on_intel do
    url "https://github.com/vexornp/mcp-cli-proxy/releases/download/v0.1.0/mcp-cli-proxy-x86_64-apple-darwin.tar.gz"
    sha256 "REPLACE_WITH_INTEL_SHA256"
  end

  def install
    bin.install "mcp-cli-proxy"
  end

  test do
    assert_match "mcp-cli-proxy", shell_output("#{bin}/mcp-cli-proxy --help")
  end
end
